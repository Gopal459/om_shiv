# ==============================================================================
# Omshiv Buildvision CRM & Propira Engine - Environment Template
# Copy this file to .env and customize for your local setup.
# ==============================================================================

PROJECT_NAME="Omshiv Buildvision CRM"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# Local SQLite (zero setup):
DATABASE_URL="sqlite+aiosqlite:///./omshiv_dev.db"

# Or PostgreSQL (production):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/omshiv_crm"

REDIS_URL="redis://localhost:6379/0"

SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

DOUBLETICK_API_KEY=""
DOUBLETICK_API_URL="https://api.doubletick.io/v1"
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
