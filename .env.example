# ==============================================================================
# Environment Configuration for Omshiv CRM Monorepo
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Omshiv CRM"
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_USER=omshiv
POSTGRES_PASSWORD=omshiv_password
POSTGRES_DB=omshiv_crm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omshiv:omshiv_password@localhost:5432/omshiv_crm

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# External Gateways & Integrations
DOUBLETICK_API_KEY=mock-doubletick-api-key
DOUBLETICK_BASE_URL=https://public.doubletick.io/v1
SMS_PROVIDER=MSG91
SMS_API_KEY=mock-sms-api-key
SMS_SENDER_ID=OMSHIV
